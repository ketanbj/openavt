# OpenAVT voice-agent demo
# Copy to .env and configure the key locally. Do not send it in chat.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-6.1-sol
OPENAI_AGENT_REASONING_EFFORT=low
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_ASR_MODEL=gpt-transcribe

# Optional live Twilio SDK demo (two numbers owned by this account).
# Public HTTPS/WSS origin forwarded to localhost:8080; see docs/integration.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_NUMBER=
TWILIO_BUSINESS_NUMBER=
TWILIO_PUBLIC_BASE_URL=
TWILIO_LISTEN_PORT=8080
