include README.md LICENSE CHANGELOG.md .env.example uv.lock
recursive-include docs *.md
recursive-include docs/performance *.json
recursive-include tests *.py
prune output
prune .venv
prune .git
prune .pytest_cache
prune build
prune dist
global-exclude __pycache__ *.py[cod] .DS_Store .env *.key *.wav
recursive-include scripts *.py
